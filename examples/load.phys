    "rules": [
        {
            "compare": ">",
            "name": "right spring pushed in: drive left",
            "op": "negate",
            "property": "motorSpeed",
            "subject": "prismatic_1",
            "target": "revolute_1",
            "watch": "translation",
            "when": 30
        },
        {
            "action": "@clone",
            "actionParams": {
                "x": 245,
                "y": 0
            },
            "actions": [
                {
                    "action": "@clone",
                    "actionParams": {
                        "x": 245,
                        "y": 0
                    },
                    "op": "set",
                    "property": "",
                    "target": "body_11",
                    "value": null
                },
                {
                    "op": "set",
                    "property": "loaded",
                    "target": "@variables",
                    "value": true
                }
            ],
            "compare": ">",
            "conditions": [
                {
                    "compare": ">",
                    "subject": "prismatic_1",
                    "watch": "translation",
                    "when": 30
                },
                {
                    "compare": "=",
                    "subject": "@variables",
                    "watch": "loaded",
                    "when": false
                }
            ],
            "join": "all",
            "name": "right spring pushed in, empty: load one ball",
            "op": "set",
            "property": "",
            "subject": "prismatic_1",
            "target": "body_11",
            "value": null,
            "watch": "translation",
            "when": 30
        },
        {
            "compare": "<",
            "name": "left spring pushed in: drive right",
            "op": "negate",
            "property": "motorSpeed",
            "subject": "prismatic_2",
            "target": "revolute_1",
            "watch": "translation",
            "when": -30
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "revolute_3",
                    "value": -120
                },
                {
                    "op": "set",
                    "property": "loaded",
                    "target": "@variables",
                    "value": false
                }
            ],
            "compare": "<",
            "conditions": [
                {
                    "compare": "<",
                    "subject": "prismatic_2",
                    "watch": "translation",
                    "when": -30
                },
                {
                    "compare": "=",
                    "subject": "@variables",
                    "watch": "loaded",
                    "when": true
                }
            ],
            "join": "all",
            "name": "left spring pushed in, loaded: tip the ball out",
            "op": "set",
            "property": "motorSpeed",
            "subject": "prismatic_2",
            "target": "revolute_3",
            "value": -120,
            "watch": "translation",
            "when": -30
        },
        {
            "compare": ">",
            "conditions": [
                {
                    "compare": ">",
                    "subject": "body_5",
                    "watch": "positionX",
                    "when": -150
                },
                {
                    "compare": "<",
                    "subject": "revolute_3",
                    "watch": "angle",
                    "when": -10
                }
            ],
            "join": "all",
            "name": "car clear of the left: bed back down",
            "op": "set",
            "property": "motorSpeed",
            "subject": "body_5",
            "target": "revolute_3",
            "value": 60,
            "watch": "positionX",
            "when": -150
        }
    ],
