            },
            "axis": {
                "x": -8.835609383516605e-17,
                "y": -1
            },
            "bodyA": "body_3",
            "bodyB": "body_4",
            "collideConnected": false,
            "name": "revolute_1",
            "params": {
                "constraintDampingRatio": 2,
                "constraintHertz": 60,
                "dampingRatio": 0,
                "drawSize": 0.25,
                "enableLimit": false,
                "enableMotor": true,
                "enableSpring": false,
                "forceThreshold": 1000000,
                "hertz": 0,
                "lowerAngle": 0,
                "maxMotorTorque": 0,
                "motorSpeed": 0,
                "referenceAngle": 0,
                "targetAngle": 0,
                "torqueThreshold": 1000000,
                "upperAngle": 0
            },
            "type": "revolute"
        }
    ],
    "log": [
        {
            "label": "Motor Torque (N·m)",
            "object": "revolute_1",
            "plotted": true,
            "property": "motorTorque"
        },
        {
            "label": "Motor Speed (deg/s)",
            "object": "revolute_1",
            "plotted": true,
            "property": "motorSpeed"
        },
        {
            "label": "Angular Velocity (deg/s)",
            "object": "body_4",
            "plotted": true,
            "property": "angularVelocity"
        }
    ],
    "rules": [
        {
            "action": "@clone",
            "actionParams": {
                "x": -20,
                "y": -160
            },
            "compare": "<",
            "conditions": [
                {
                    "compare": "<",
                    "subject": "@world",
                    "watch": "frame",
                    "when": 60
                },
                {
                    "compare": "%",
                    "subject": "@world",
                    "watch": "frame",
                    "when": 2
                }
            ],
            "join": "all",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "body_2",
            "value": false,
            "watch": "frame",
            "when": 60
        },
        {
            "event": "@controlChanged",
            "op": "set",
            "property": "motorSpeed",
            "sourceObject": "@controls",
            "sourceOffset": 0,
            "sourceProperty": {
                "control": "speed",
                "property": "value"
            },
            "subject": "@controls",
            "target": "revolute_1",
            "value": false,
            "when": "speed"
        },
        {
            "event": "@controlChanged",
            "op": "set",
            "property": "maxMotorTorque",
            "sourceObject": "@controls",
            "sourceOffset": 0,
            "sourceProperty": {
                "control": "torque",
                "property": "value"
            },
            "subject": "@controls",
            "target": "revolute_1",
            "value": false,
            "when": "torque"
        },
        {
            "action": "@showCaption",
            "actionParams": {
                "shown": true,
                "text": "Wheel {body_4:angularVelocity} of {revolute_1:motorSpeed} deg/s<br>Torque {revolute_1:motorTorque} of {revolute_1:maxMotorTorque} N·m"
            },
            "event": "@runStarted",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "@world",
            "value": null
        }
    ],
