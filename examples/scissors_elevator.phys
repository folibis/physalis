    "log": [
        {
            "label": "Angle (deg)",
            "object": "scissors_motor",
            "property": "angle"
        },
        {
            "label": "Motor Speed (deg/s)",
            "object": "scissors_motor",
            "property": "motorSpeed"
        },
        {
            "label": "Enabled",
            "object": "scissors_motor",
            "property": "enableMotor"
        }
    ],
    "rules": [
        {
            "event": "contactBegin",
            "name": "start up",
            "op": "set",
            "property": "enableMotor",
            "subject": "circle_1",
            "target": "scissors_motor",
            "value": true,
            "when": "rectangle_14"
        },
        {
            "compare": "<",
            "name": "lift up stop",
            "op": "set",
            "property": "motorSpeed",
            "subject": "scissors_motor",
            "target": "scissors_motor",
            "value": false,
            "watch": "angle",
            "when": -14
        },
        {
            "event": "sensorBegin",
            "name": "wind on",
            "op": "set",
            "property": "gravityScale",
            "subject": "rectangle_16",
            "target": "body_16",
            "value": -1,
            "when": "circle_1"
        },
        {
            "event": "sensorEnd",
            "name": "wind off",
            "op": "set",
            "property": "gravityScale",
            "subject": "rectangle_16",
            "target": "body_16",
            "value": 1,
            "when": "circle_1"
        },
        {
            "event": "contactBegin",
            "name": "lift go down",
            "op": "set",
            "property": "motorSpeed",
            "subject": "circle_1",
            "target": "scissors_motor",
            "value": 10,
            "when": "polyline_1"
        },
        {
            "compare": ">",
            "name": "lift down stop",
            "op": "set",
            "property": "enableMotor",
            "subject": "scissors_motor",
            "target": "scissors_motor",
            "value": false,
            "watch": "angle",
            "when": 0
        },
        {
            "event": "sensorEnd",
            "name": "lift ready",
            "op": "set",
            "property": "motorSpeed",
            "subject": "rectangle_16",
            "target": "scissors_motor",
            "value": -10,
            "when": ""
        }
    ],
