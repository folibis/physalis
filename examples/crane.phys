            "compare": "<",
            "conditions": [
                {
                    "compare": "<",
                    "subject": "@world",
                    "watch": "frame",
                    "when": 40
                },
                {
                    "compare": "%",
                    "subject": "@world",
                    "watch": "frame",
                    "when": 2
                }
            ],
            "join": "all",
            "name": "generate items",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "item_1",
            "value": false,
            "watch": "frame",
            "when": 40
        },
        {
            "event": "limitEither",
            "name": "slide left-right",
            "op": "negate",
            "property": "motorSpeed",
            "subject": "traverse",
            "target": "traverse",
            "when": ""
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "traverse",
                    "value": 0
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hoist",
                    "value": 100
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_left",
                    "value": -20
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_right",
                    "value": 20
                }
            ],
            "conditions": [
                {
                    "event": "@keyPressed",
                    "subject": "@keyboard",
                    "when": "Space"
                },
                {
                    "compare": "=",
                    "subject": "@variables",
                    "watch": "full",
                    "when": false
                }
            ],
            "event": "@keyPressed",
            "join": "all",
            "name": "space: open and go down",
            "op": "set",
            "property": "motorSpeed",
            "subject": "@keyboard",
            "target": "traverse",
            "value": 0,
            "when": "Space"
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hoist",
                    "value": 0
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_left",
                    "value": 20
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_right",
                    "value": -20
                }
            ],
            "compare": ">=",
            "conditions": [
                {
                    "compare": ">=",
                    "subject": "hoist",
                    "watch": "translation",
                    "when": 249
                },
                {
                    "compare": ">=",
                    "subject": "hoist",
                    "watch": "motorForce",
                    "when": 190
                }
            ],
            "join": "any",
            "name": "at the bottom: close the claws",
            "op": "set",
            "property": "motorSpeed",
            "subject": "hoist",
            "target": "hoist",
            "value": 0,
            "watch": "translation",
            "when": 249
        },
        {
            "compare": ">=",
            "conditions": [
                {
                    "compare": ">=",
                    "subject": "hoist",
                    "watch": "translation",
                    "when": 100
                },
                {
                    "compare": ">=",
                    "subject": "hinge_left",
                    "watch": "motorTorque",
                    "when": 190
                }
            ],
            "join": "all",
            "name": "gripped: lift",
            "op": "set",
            "property": "motorSpeed",
            "subject": "hoist",
            "target": "hoist",
            "value": -100,
            "watch": "translation",
            "when": 100
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hoist",
                    "value": 0
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "traverse",
                    "value": 120
                },
                {
                    "op": "set",
                    "property": "full",
                    "target": "@variables",
                    "value": true
                },
                {
                    "op": "set",
                    "property": "upperTranslation",
                    "target": "traverse",
                    "value": 700
                }
            ],
            "event": "limitLower",
            "name": "back at the top: carry it away",
            "op": "set",
            "property": "motorSpeed",
            "subject": "hoist",
            "target": "hoist",
            "value": 0
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "traverse",
                    "value": 0
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_left",
                    "value": -10
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_right",
                    "value": 10
                }
            ],
            "conditions": [
                {
                    "event": "limitUpper",
                    "subject": "traverse"
                },
                {
                    "compare": "=",
                    "subject": "@variables",
                    "watch": "full",
                    "when": true
                }
            ],
            "event": "limitUpper",
            "join": "all",
            "name": "at the far end: let go",
            "op": "set",
            "property": "motorSpeed",
            "subject": "traverse",
            "target": "traverse",
            "value": 0
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "traverse",
                    "value": -120
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_left",
                    "value": 20
                },
                {
                    "op": "set",
                    "property": "motorSpeed",
                    "target": "hinge_right",
                    "value": -20
                }
            ],
            "compare": "<=",
            "conditions": [
                {
                    "compare": "<=",
                    "subject": "hinge_left",
                    "watch": "angle",
                    "when": -24
                },
                {
                    "compare": ">=",
                    "subject": "traverse",
                    "watch": "translation",
                    "when": 650
                }
            ],
            "join": "all",
            "name": "dropped: go back",
            "op": "set",
            "property": "motorSpeed",
            "subject": "hinge_left",
            "target": "traverse",
            "value": -120,
            "watch": "angle",
            "when": -24
        },
        {
            "actions": [
                {
                    "op": "set",
                    "property": "upperTranslation",
                    "target": "traverse",
                    "value": 500
                },
                {
                    "op": "set",
                    "property": "full",
                    "target": "@variables",
                    "value": false
                }
            ],
            "compare": "<=",
            "name": "back inside: the rail and the crane are free again",
            "op": "set",
            "property": "upperTranslation",
            "subject": "traverse",
            "target": "traverse",
            "value": 500,
