    "rules": [
        {
            "action": "@showCaption",
            "actionParams": {
                "shown": true,
                "text": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Press <span style=\" font-weight:700;\">Space</span> to activate handler</p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Try to throw the ball into the basket.</p></body></html>"
            },
            "event": "@runStarted",
            "name": "info",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "@world",
            "value": false,
            "when": ""
        },
        {
            "action": "@clone",
            "actionParams": {
                "x": -380,
                "y": -100
            },
            "actions": [
                {
                    "action": "@clone",
                    "actionParams": {
                        "x": -380,
                        "y": -100
                    },
                    "op": "set",
                    "property": "",
                    "target": "circle_1",
                    "value": false
                },
                {
                    "op": "add",
                    "property": "balls",
                    "target": "@variables",
                    "value": 1
                }
            ],
            "compare": "%",
            "name": "create ball",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "circle_1",
            "value": false,
            "watch": "frame",
            "when": 200
        },
        {
            "event": "@keyPressed",
            "name": "activate flipper",
            "op": "set",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_1",
            "value": true,
            "when": "Space"
        },
        {
            "event": "@keyReleased",
            "name": "deactivate flipper",
            "op": "set",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_1",
            "value": false,
            "when": "Space"
        },
        {
            "action": "removeBody",
            "actionParams": {
            },
            "event": "rayDetects",
            "name": "remove ball",
            "op": "set",
            "property": "",
            "subject": "ray_1",
            "target": "@otherBody",
            "value": false,
            "when": ""
        },
        {
            "actions": [
                {
                    "op": "add",
                    "property": "score",
                    "target": "@variables",
                    "value": 1
                },
                {
                    "action": "removeBody",
                    "actionParams": {
                    },
                    "op": "set",
                    "property": "",
                    "target": "@otherBody",
                    "value": 0
                }
            ],
            "event": "rayDetects",
            "name": "add score",
            "op": "add",
            "property": "score",
            "subject": "ray_2",
            "target": "@variables",
            "value": 1,
            "when": ""
        }
    ],
