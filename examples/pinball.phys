    "log": [
        {
            "label": "score",
            "object": "@variables",
            "plotted": false,
            "property": "score"
        }
    ],
    "rules": [
        {
            "event": "@keyPressed",
            "name": "left flipper on",
            "op": "set",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_2",
            "value": true,
            "when": "Left"
        },
        {
            "event": "@keyReleased",
            "name": "left flipper off",
            "op": "set",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_2",
            "value": false,
            "when": "Left"
        },
        {
            "event": "@keyPressed",
            "name": "right flipper on",
            "op": "set",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_3",
            "value": true,
            "when": "Right"
        },
        {
            "event": "@keyReleased",
            "name": "right flipper off",
            "op": "set",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_3",
            "value": false,
            "when": "Right"
        },
        {
            "conditions": [
                {
                    "event": "sensorBegin",
                    "subject": "rectangle_11",
                    "when": "circle_1"
                },
                {
                    "event": "sensorBegin",
                    "subject": "rectangle_12",
                    "when": "circle_1"
                }
            ],
            "event": "sensorBegin",
            "join": "any",
            "name": "side force",
            "op": "set",
            "property": "impulseY",
            "subject": "rectangle_11",
            "target": "@otherBody",
            "value": {
                "from": -200,
                "step": 10,
                "to": -500
            },
            "when": "circle_1"
        },
        {
            "conditions": [
                {
                    "event": "sensorBegin",
                    "subject": "rectangle_16",
                    "when": "circle_1"
                },
                {
                    "event": "sensorBegin",
                    "subject": "rectangle_17",
                    "when": "circle_1"
                },
                {
                    "event": "sensorBegin",
                    "subject": "polygon_12",
                    "when": "circle_1"
                },
                {
                    "event": "sensorBegin",
                    "subject": "polygon_11",
                    "when": "circle_1"
                }
            ],
            "event": "sensorBegin",
            "join": "any",
            "name": "score",
            "op": "add",
            "property": "score",
            "subject": "rectangle_16",
            "target": "@variables",
            "value": 1,
            "when": "circle_1"
        },
        {
            "action": "@stopRun",
            "actionParams": {
            },
            "conditions": [
                {
                    "event": "sensorBegin",
                    "subject": "rectangle_15",
                    "when": "circle_3"
                },
                {
                    "compare": ">",
                    "subject": "@variables",
                    "watch": "score",
                    "when": 100
                }
            ],
            "event": "sensorBegin",
            "join": "any",
            "name": "end game",
            "op": "set",
            "property": "",
            "subject": "rectangle_15",
            "target": "@world",
            "value": false,
            "when": "circle_3"
        },
        {
            "actions": [
                {
                    "op": "toggle",
                    "property": "enableMotor",
                    "target": "revolute_5"
                },
                {
                    "op": "toggle",
                    "property": "enableMotor",
                    "target": "revolute_6"
                }
            ],
            "event": "@keyPressed",
            "name": "stop mixer",
            "op": "toggle",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_5",
            "when": "Space"
        },
        {
            "action": "@showCaption",
            "actionParams": {
                "shown": true,
                "text": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Use <span style=\" font-weight:700;\">Left</span>/<span style=\" font-weight:700;\">Right</span> arrows</p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">to control the flippers</p></body></html>"
            },
            "event": "@runStarted",
            "name": "start game",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "@world",
            "value": false,
            "when": ""
        }
    ],
