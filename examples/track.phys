    "rules": [
        {
            "event": "@keyPressed",
            "name": "Start/Stop",
            "op": "toggle",
            "property": "enableMotor",
            "subject": "@keyboard",
            "target": "revolute_27",
            "when": "Enter"
        },
        {
            "event": "@controlPressed",
            "name": "Start button",
            "op": "toggle",
            "property": "enableMotor",
            "subject": "@controls",
            "target": "revolute_27",
            "when": "start_control"
        },
        {
            "event": "@keyPressed",
            "name": "Speed up",
            "op": "add",
            "property": {
                "control": "speed_control",
                "property": "value"
            },
            "subject": "@keyboard",
            "target": "@controls",
            "value": 10,
            "when": "Up"
        },
        {
            "event": "@keyPressed",
            "name": "Speed down",
            "op": "subtract",
            "property": {
                "control": "speed_control",
                "property": "value"
            },
            "subject": "@keyboard",
            "target": "@controls",
            "value": 10,
            "when": "Down"
        },
        {
            "event": "@controlChanged",
            "name": "Slider sets the speed",
            "op": "set",
            "property": "motorSpeed",
            "sourceObject": "@controls",
            "sourceOffset": 0,
            "sourceProperty": {
                "control": "speed_control",
                "property": "value"
            },
            "subject": "@controls",
            "target": "revolute_27",
            "value": 0,
            "when": "speed_control"
        },
        {
            "compare": "=",
            "name": "Button says Stop",
            "op": "set",
            "property": {
                "control": "start_control",
                "property": "caption"
            },
            "subject": "revolute_27",
            "target": "@controls",
            "value": "Stop",
            "watch": "motorEnabled",
            "when": true
        },
        {
            "compare": "=",
            "name": "Button says Start",
            "op": "set",
            "property": {
                "control": "start_control",
                "property": "caption"
            },
            "subject": "revolute_27",
            "target": "@controls",
            "value": "Start",
            "watch": "motorEnabled",
            "when": false
        },
        {
            "action": "@showCaption",
            "actionParams": {
                "shown": true,
                "text": "<p><b>Enter</b> or <b>Start</b> works the motor.<br/><b>Up</b> and <b>Down</b> change its speed.</p>"
            },
            "event": "@runStarted",
            "name": "caption",
            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "@world",
            "value": null
        }
    ],
