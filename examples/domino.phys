            "subject": "polygon_4",
            "target": "prismatic_2",
            "value": true,
            "when": "circle_4"
        },
        {
            "action": "removeBody",
            "actionParams": {
            },
            "event": "contactBegin",
            "name": "end",
            "op": "set",
            "property": "",
            "subject": "circle_4",
            "target": "body_34",
            "value": false,
            "when": "polyline_2"
        },
        {
            "event": "contactBegin",
            "name": "final lift start",
            "op": "set",
            "property": "enableMotor",
            "subject": "circle_4",
            "target": "prismatic_3",
            "value": true,
            "when": "rectangle_41"
        },
        {
            "event": "limitUpper",
            "name": "final lift stop",
            "op": "set",
            "property": "motorSpeed",
            "subject": "prismatic_3",
            "target": "prismatic_3",
            "value": false,
            "when": ""
        },
        {
            "action": "@stopRun",
            "actionParams": {
            },
            "event": "contactBegin",
            "name": "end",
            "op": "set",
            "property": "",
            "subject": "circle_1",
            "target": "@world",
            "value": false,
            "when": "circle_4"
        }
    ],
