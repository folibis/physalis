            "op": "set",
            "property": "",
            "subject": "@world",
            "target": "@world",
            "value": null
        },
        {
            "action": "pushAt",
            "actionParams": {
                "impulseX": 0,
                "impulseY": -1,
                "offsetX": -80,
                "offsetY": 0,
                "relative": true
            },
            "actions": [
                {
