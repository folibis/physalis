# Qt's own style (qt5/_clang-format), changed in these ways:
#   - every if/else/for/while/do body gets braces, even a single statement
#   - every block's braces sit on lines of their own: functions, classes,
#     enums, control statements, namespaces -- but not a lambda's, see below
#   - lines run to 120 columns, and anything that fits on one line is kept on
#     one: calls, declarations, constructor initialisers
#
# Written for clang-format 16, the one Qt Creator ships. Naming is not something
# clang-format can check -- that lives in .clang-tidy.
Language: Cpp
Standard: c++17
BasedOnStyle: WebKit

ColumnLimit: 120
IndentWidth: 4
ContinuationIndentWidth: 8
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: false
IndentPPDirectives: None

# Braces on their own lines, for every kind of block.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  # Off, so a lambda keeps its capture on the line of the call it is passed
  # to. clang-format 16 cannot put a lambda's brace on a line of its own
  # without also breaking before the capture list.
  BeforeLambdaBody: false
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# Braces even around a single statement -- clang-format adds them.
InsertBraces: true

# A lambda's body is indented from the statement it sits in, so its closing
# brace lines up with the start of the call:
#   connect(joint, &Joint::propertyChanged, this, [this] {
#       update();
#   });
LambdaBodyIndentation: OuterScope

# Nothing with a body is squeezed onto one line.
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false

# ...but a call or a declaration that fits in 120 columns stays on one line,
# and is only broken when it has to be.
BinPackArguments: true
BinPackParameters: true
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
AlignAfterOpenBracket: Align
AlwaysBreakAfterReturnType: None
AlwaysBreakTemplateDeclarations: Yes
PenaltyReturnTypeOnItsOwnLine: 1000
PenaltyBreakAssignment: 100
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: CurrentLine
BreakInheritanceList: BeforeComma
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
BreakStringLiterals: true

PointerAlignment: Right
ReferenceAlignment: Pointer
DerivePointerAlignment: false
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: false
SpaceBeforeCpp11BracedList: false
SpaceBeforeParens: ControlStatements
SpacesInContainerLiterals: false
Cpp11BracedListStyle: true

AlignTrailingComments: true
AlignEscapedNewlines: Left
AlignOperands: Align
ReflowComments: true
FixNamespaceComments: true
CommentPragmas: '^ IWYU pragma:'

EmptyLineBeforeAccessModifier: LogicalBlock
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

# Qt's include order is deliberate in places; leave it to the author.
SortIncludes: Never
SortUsingDeclarations: false

ForEachMacros:
  - forever
  - foreach
  - Q_FOREACH
  - Q_FOREVER
  - QBENCHMARK
  - QBENCHMARK_ONCE
StatementAttributeLikeMacros:
  - Q_EMIT
  - emit
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION
  - Q_OBJECT
  - Q_GADGET
