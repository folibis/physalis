import QtQuick
import QtQuick.Shapes
import Box2D 2.0

// {{TITLE}} -- generated by Physalis.
//
// The scene as qml-box2d objects: a World, one Body per body with its fixtures
// and what it looks like, and the joints between them. afterStep() runs once
// the world has stepped and does what the scene's rules say, as ordinary
// JavaScript.
//
// qml-box2d works in the units the scene was drawn in: lengths in pixels
// ({{PIXELS_PER_METER}} to the metre), angles in degrees, Y pointing down. Velocities
// are in metres per second, which is why a rule below divides a speed by ppm.

Rectangle {
    id: scene
    color: "{{BACKGROUND}}"
    clip: true

    property bool running: true
    property bool debug: false
    signal holdRequested()
    signal stopRequested()

    readonly property real ppm: {{PIXELS_PER_METER}}
    readonly property real dt: 1 / {{STEPS_PER_SECOND}}
    {{STATE}}

    World {
        id: world
        pixelsPerMeter: scene.ppm
        timeStep: scene.dt
        gravity: Qt.point({{GRAVITY_X}}, {{GRAVITY_Y}})
        running: scene.running
        onStepped: scene.afterStep()
        {{PRE_SOLVE}}
    }

    // The editor's coordinates: (0, 0) is the middle of the field.
    Item {
        id: field
        x: scene.width / 2
        y: scene.height / 2

        {{BODIES}}

        {{FIELD_BOUNDS}}

        {{JOINTS}}

        {{RAYS}}

        {{CLONES}}

        DebugDraw {
            world: world
            // Fixtures only: each body draws its own axes, where the editor
            // puts its centre of mass, and the joints are drawn below.
            flags: DebugDraw.Shape
            visible: scene.debug
            opacity: 0.75
        }

        {{JOINT_VIEW}}
    }

    function afterStep() {
        {{STEP}}
    }

    {{HELPERS}}
}
