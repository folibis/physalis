import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import QtQuick.Window

// {{TITLE}} -- generated by Physalis.
//
// The window around the scene. Scene.qml is loaded through a Loader, so Reset
// is simply loading it again: every body, joint and rule starts over.

Window {
    id: window
    width: {{WIDTH}}
    height: {{HEIGHT}}{{CONTROLS_HEIGHT}}
    visible: true
    title: "{{TITLE}}"
    color: "#2b2b2b"

    property bool running: true
    property bool debug: {{DEBUG_VIEW}}

    function reset() {
        loader.active = false;
        loader.active = true;
    }

    Shortcut {
        sequence: "Space"
        onActivated: window.running = !window.running
    }

    ColumnLayout {
        anchors.fill: parent
        spacing: 0
        {{CONTROLS}}
        Loader {
            id: loader
            Layout.fillWidth: true
            Layout.fillHeight: true
            source: "Scene.qml"
            onLoaded: {
                item.running = Qt.binding(function () { return window.running; });
                item.debug = Qt.binding(function () { return window.debug; });
                item.holdRequested.connect(function () { window.running = false; });
                item.stopRequested.connect(function () {
                    window.running = false;
                    Qt.callLater(window.reset);
                });
            }
        }
    }
}
