//! Every shape of every dynamic body as an explosion sees it: [body, outline in
//! the body's own frame (a circle is its centre), radius, collision group].
readonly property var blastShapes: [{{BLAST_SHAPES}}]

// Box2D 2.3 has no explosion; this is Box2D v3's, as the editor runs it.
function explode(cx, cy, impulse, radius, falloff, mask) {
    for (var i = 0; i < blastShapes.length; ++i) {
        var body = blastShapes[i][0];
        var round = blastShapes[i][2];
        if (!body.active || (mask && (blastShapes[i][3] & mask) === 0))
            continue;
        var turn = body.target.rotation * Math.PI / 180;
        var cos = Math.cos(turn), sin = Math.sin(turn);
        var pts = blastShapes[i][1].map(function (p) {
            return Qt.point(body.target.x + p[0] * cos - p[1] * sin, body.target.y + p[0] * sin + p[1] * cos);
        });
        var near = nearestPoint(pts, round, cx, cy);
        if (near.distance > radius + falloff)
            continue;
        var dx = near.x - cx, dy = near.y - cy;
        var length = Math.sqrt(dx * dx + dy * dy);
        if (length > 1e-6) {
            dx /= length;
            dy /= length;
        } else {
            dx = 1;
            dy = 0;
        }
        // How wide the shape is across the line of the blast.
        var lower = Infinity, upper = -Infinity;
        for (var k = 0; k < pts.length; ++k) {
            var along = pts[k].y * dx - pts[k].x * dy;
            lower = Math.min(lower, along);
            upper = Math.max(upper, along);
        }
        var width = upper - lower + 2 * round;
        var fade = near.distance > radius && falloff > 0
            ? Math.max(0, Math.min(1, (radius + falloff - near.distance) / falloff)) : 1;
        var magnitude = impulse / ppm * width / ppm * fade;
        body.applyLinearImpulse(Qt.point(dx * magnitude, dy * magnitude), Qt.point(near.x, near.y));
    }
}

// The point of a convex outline (or a circle, one point and a radius) nearest
// to (px, py), and how far it is; inside it, the middle and no distance.
function nearestPoint(pts, round, px, py) {
    if (pts.length === 1) {
        var cx = pts[0].x - px, cy = pts[0].y - py;
        var d = Math.sqrt(cx * cx + cy * cy);
        if (d <= round)
            return { x: pts[0].x, y: pts[0].y, distance: 0 };
        return { x: pts[0].x - cx / d * round, y: pts[0].y - cy / d * round, distance: d - round };
    }
    var inside = true, sign = 0, best = null;
    for (var i = 0; i < pts.length; ++i) {
        var a = pts[i], b = pts[(i + 1) % pts.length];
        var ex = b.x - a.x, ey = b.y - a.y;
        var cross = ex * (py - a.y) - ey * (px - a.x);
        if (cross !== 0) {
            if (sign && (cross > 0) !== (sign > 0))
                inside = false;
            sign = cross;
        }
        var t = Math.max(0, Math.min(1, ((px - a.x) * ex + (py - a.y) * ey) / (ex * ex + ey * ey || 1)));
        var qx = a.x + ex * t, qy = a.y + ey * t;
        var dist = Math.sqrt((qx - px) * (qx - px) + (qy - py) * (qy - py));
        if (!best || dist < best.distance)
            best = { x: qx, y: qy, distance: dist };
    }
    if (inside) {
        var mx = 0, my = 0;
        for (var j = 0; j < pts.length; ++j) {
            mx += pts[j].x / pts.length;
            my += pts[j].y / pts.length;
        }
        return { x: mx, y: my, distance: 0 };
    }
    return best;
}
