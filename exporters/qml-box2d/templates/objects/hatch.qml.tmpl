//! A sensor's hatching, laid over its outline (SensorHatch.qml).
SensorHatch {
    x: {{X}}
    y: {{Y}}
    width: {{WIDTH}}
    height: {{HEIGHT}}
    rotation: {{ROTATION}}
    color: "{{COLOR}}"
    pattern: Qt.{{PATTERN}}
    outline: "{{OUTLINE}}"
    radius: {{RADIUS}}
    points: [{{POINTS}}]
}
