//! A box or a circle as the editor draws it, in the body's own coordinates.
Rectangle {
    x: {{X}}
    y: {{Y}}
    width: {{WIDTH}}
    height: {{HEIGHT}}
    rotation: {{ROTATION}}
    radius: {{RADIUS}}
    color: "{{FILL}}"
    border.color: "{{STROKE}}"
    border.width: 1.5
    antialiasing: true
}
