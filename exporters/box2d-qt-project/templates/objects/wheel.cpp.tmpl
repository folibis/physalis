//! A field without a value is left out, and b2DefaultWheelJointDef's stands.
{
    b2WheelJointDef jointDef = b2DefaultWheelJointDef();
    jointDef.base.bodyIdA = {{BODY_A}};
    jointDef.base.bodyIdB = {{BODY_B}};
    //! Frame A's x axis is the axis for the kinds that slide; frame B is turned
    //! back by the reference angle, so the bodies rest that far apart.
    jointDef.base.localFrameA = b2Transform{
        b2Body_GetLocalPoint({{BODY_A}}, m({{ANCHOR_A_X}}, {{ANCHOR_A_Y}})),
        b2MakeRot(rad({{FRAME_A_DEG}})) };
    jointDef.base.localFrameB = b2Transform{
        b2Body_GetLocalPoint({{BODY_B}}, m({{ANCHOR_B_X}}, {{ANCHOR_B_Y}})),
        b2MakeRot(rad({{FRAME_B_DEG}})) };
    jointDef.base.collideConnected = {{COLLIDE_CONNECTED}};
    jointDef.enableSpring = {{ENABLE_SPRING}};
    jointDef.hertz = {{HERTZ}};
    jointDef.dampingRatio = {{DAMPING_RATIO}};
    jointDef.enableLimit = {{ENABLE_LIMIT}};
    jointDef.lowerTranslation = m({{LOWER_TRANSLATION}});
    jointDef.upperTranslation = m({{UPPER_TRANSLATION}});
    jointDef.enableMotor = {{ENABLE_MOTOR}};
    jointDef.maxMotorTorque = {{MAX_MOTOR_TORQUE}};
    jointDef.motorSpeed = rad({{MOTOR_SPEED}});
    {{ID}} = b2CreateWheelJoint(world, &jointDef);
    b2Joint_SetConstraintTuning({{ID}}, {{CONSTRAINT_HERTZ}}, {{CONSTRAINT_DAMPING}});
}
