// Box2D asks before it solves each contact; noted here, acted on after the step.
std::vector<std::pair<b2ShapeId, b2ShapeId>> aboutToTouch;
// 3.2 tells rather than asks: the callback returns nothing.
void notePreSolve(b2ShapeId a, b2ShapeId b, b2Manifold *, void *)
{
    aboutToTouch.emplace_back(a, b);
}
