const float PIXELS_PER_METER = {{PIXELS_PER_METER}}f;

b2Vec2 m(float x, float y) { return b2Vec2{ x / PIXELS_PER_METER, y / PIXELS_PER_METER }; }
float m(float length) { return length / PIXELS_PER_METER; }
float rad(float degrees) { return degrees * B2_PI / 180.0f; }

// The editor paints a body by what it is -- dynamic, static, kinematic -- and
// Box2D lets a shape carry its own debug-draw colour, so each shape is given
// its body's.
const b2HexColor COLOR_DYNAMIC = b2HexColor(0x{{COLOR_DYNAMIC}});
const b2HexColor COLOR_STATIC = b2HexColor(0x{{COLOR_STATIC}});
const b2HexColor COLOR_KINEMATIC = b2HexColor(0x{{COLOR_KINEMATIC}});
const int FILL_ALPHA = {{FILL_ALPHA}};

// A sensor is drawn open and hatched, the way the editor draws it. Box2D hands
// a shape's custom colour to the draw callbacks as it is, so a bit above the 24
// an RGB colour uses marks the shapes that are sensors.
const uint32_t SENSOR = 0x1000000;
const QColor SENSOR_COLOR({{SENSOR_COLOR}});
const Qt::BrushStyle SENSOR_PATTERN = Qt::{{SENSOR_PATTERN}};
const bool SENSOR_FILLED = {{SENSOR_FILLED}};

b2WorldId world;
// A rule asked for the run to end (1) or hold (2). Not inside the step, where the
// rule is: the view carries it out once the step is over.
int pendingRun = 0;
