// {{TITLE}} -- generated by Physalis.
//
// A plain Box2D v3 program. createWorld() makes the world, its bodies, shapes
// and joints; step() advances it and then does what the scene's rules say;
// the window draws it all with Box2D's own b2World_Draw. Qt is only the
// window.
//
// Box2D works in metres. The scene was drawn at {{PIXELS_PER_METER}} units per
// metre, so a length below is written m(...) in the units it was drawn in, and
// an angle is written rad(...) in degrees.

#include <box2d/box2d.h>

