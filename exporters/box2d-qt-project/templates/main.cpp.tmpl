// --- the window ------------------------------------------------------------

class SceneView : public QWidget
{
public:
    SceneView()
    {
        // The whole field, at one pixel per scene unit; the scroll area around
        // the view takes care of a field bigger than the screen.
        setMinimumSize({{WIDTH}}, {{HEIGHT}});
        setFocusPolicy(Qt::StrongFocus);

        createWorld();

        QObject::connect(&timer, &QTimer::timeout, this, [this] {
            step(1.0f / {{STEPS_PER_SECOND}});
            if (pendingRun) {
                const int what = pendingRun;
                pendingRun = 0;
                if (what == 1)
                    reset();
                else
                    run(false);
            }
            update();
        });
        timer.start(1000 / {{STEPS_PER_SECOND}});
    }

    ~SceneView() override { b2DestroyWorld(world); }

    bool debug = {{DEBUG_VIEW}};

    bool isRunning() const { return timer.isActive(); }

    void run(bool on)
    {
        if (on)
            timer.start();
        else
            timer.stop();
    }

    // Back to the beginning, and waiting to be started.
    void reset()
    {
        b2DestroyWorld(world);
        createWorld();
        run(false);
        update();
    }

    void setDebug(bool on)
    {
        debug = on;
        update();
    }

protected:
    void paintEvent(QPaintEvent *) override
    {
        QPainter painter(this);
        painter.fillRect(rect(), QColor("{{BACKGROUND}}"));
        painter.setRenderHint(QPainter::Antialiasing);
        painter.translate(width() / 2.0 - {{VIEW_CENTER_X}}, height() / 2.0 - {{VIEW_CENTER_Y}});
        painter.scale(PIXELS_PER_METER, PIXELS_PER_METER);

        b2DebugDraw draw = b2DefaultDebugDraw();
        draw.DrawPolygonFcn = drawPolygon;
        draw.DrawSolidPolygonFcn = drawSolidPolygon;
        draw.DrawCircleFcn = drawCircle;
        draw.DrawSolidCircleFcn = drawSolidCircle;
        draw.DrawSolidCapsuleFcn = drawSolidCapsule;
        draw.DrawSegmentFcn = drawSegment;
        draw.DrawTransformFcn = drawTransform;
        draw.DrawPointFcn = drawPoint;
        draw.DrawStringFcn = drawString;
        draw.drawShapes = true;
        draw.context = &painter;
        b2World_Draw(world, &draw);

        {{DEBUG_DRAWING}}
    }

    // Space runs and pauses, R goes back to the beginning, D shows joints and
    // centres of mass.
    void keyPressEvent(QKeyEvent *event) override
    {
        if (event->key() == Qt::Key_Space)
            run(!isRunning());
        else if (event->key() == Qt::Key_R)
            reset();
        else if (event->key() == Qt::Key_D)
            setDebug(!debug);
        else
            QWidget::keyPressEvent(event);
    }

private:
    QTimer timer;
};

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);

    QMainWindow window;
    window.setWindowTitle("{{TITLE}}");

    auto *view = new SceneView;
    auto *scroll = new QScrollArea;
    scroll->setWidget(view);
    scroll->setWidgetResizable(true);
    window.setCentralWidget(scroll);

    {{CONTROLS}}

    window.resize(std::min({{WIDTH}}, 1400), std::min({{HEIGHT}}, 800));
    window.show();
    view->setFocus();
    return app.exec();
}
