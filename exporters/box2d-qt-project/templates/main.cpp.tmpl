// --- drawing ---------------------------------------------------------------
//
// b2World_Draw walks the world and calls these for every shape and joint. The
// painter is scaled to metres, so they draw in Box2D's own units.

QColor colorOf(b2HexColor color, int alpha = 255)
{
    return QColor((color >> 16) & 0xff, (color >> 8) & 0xff, color & 0xff, alpha);
}

QPen penOf(b2HexColor color)
{
    QPen pen(colorOf(color));
    pen.setWidthF(2.0);
    pen.setCosmetic(true);  // two pixels wide, whatever the scale
    return pen;
}

bool isSensor(b2HexColor color)
{
    return (uint32_t(color) & SENSOR) != 0;
}

// A body's fill -- except a sensor's, which is left open unless the settings
// say otherwise.
QBrush fillOf(b2HexColor color)
{
    if (isSensor(color) && !SENSOR_FILLED)
        return Qt::NoBrush;
    return colorOf(color, FILL_ALPHA);
}

// A sensor's hatching, laid in screen pixels. A pattern brush drawn through the
// painter's scale to metres would stretch every cell of the pattern with it.
void hatch(QPainter *painter, const QPainterPath &shape)
{
    const QPainterPath onScreen = painter->transform().map(shape);
    painter->save();
    painter->resetTransform();
    painter->setPen(Qt::NoPen);
    painter->setBrush(QBrush(SENSOR_COLOR, SENSOR_PATTERN));
    painter->drawPath(onScreen);
    painter->restore();
}

void drawPolygon(const b2Vec2 *vertices, int count, b2HexColor color, void *context)
{
    QPolygonF polygon;
    for (int i = 0; i < count; ++i)
        polygon << QPointF(vertices[i].x, vertices[i].y);

    QPainter *painter = static_cast<QPainter *>(context);
    painter->setPen(penOf(color));
    painter->setBrush(Qt::NoBrush);
    painter->drawPolygon(polygon);
}

void drawSolidPolygon(b2Transform transform, const b2Vec2 *vertices, int count, float radius,
                      b2HexColor color, void *context)
{
    QPainterPath path;
    for (int i = 0; i < count; ++i) {
        const b2Vec2 p = b2TransformPoint(transform, vertices[i]);
        if (i == 0)
            path.moveTo(p.x, p.y);
        else
            path.lineTo(p.x, p.y);
    }
    path.closeSubpath();

    // A rounded polygon is its hull grown outward by the radius.
    if (radius > 0.0f) {
        QPainterPathStroker stroker;
        stroker.setWidth(2.0 * radius);
        stroker.setJoinStyle(Qt::RoundJoin);
        path = path.united(stroker.createStroke(path));
    }

    QPainter *painter = static_cast<QPainter *>(context);
    painter->setPen(penOf(color));
    painter->setBrush(fillOf(color));
    painter->drawPath(path);
    if (isSensor(color))
        hatch(painter, path);
}

void drawCircle(b2Vec2 center, float radius, b2HexColor color, void *context)
{
    QPainter *painter = static_cast<QPainter *>(context);
    painter->setPen(penOf(color));
    painter->setBrush(Qt::NoBrush);
    painter->drawEllipse(QPointF(center.x, center.y), radius, radius);
}

void drawSolidCircle(b2Transform transform, float radius, b2HexColor color, void *context)
{
    QPainter *painter = static_cast<QPainter *>(context);
    painter->setPen(penOf(color));
    painter->setBrush(fillOf(color));
    const QPointF center(transform.p.x, transform.p.y);
    painter->drawEllipse(center, radius, radius);
    if (isSensor(color)) {
        QPainterPath disc;
        disc.addEllipse(center, radius, radius);
        hatch(painter, disc);
    }
    // A line to the rim, so you can see it turn.
    const b2Vec2 rim = b2TransformPoint(transform, b2Vec2{ radius, 0.0f });
    painter->drawLine(center, QPointF(rim.x, rim.y));
}

void drawSolidCapsule(b2Vec2 p1, b2Vec2 p2, float radius, b2HexColor color, void *context)
{
    QPainterPath line;
    line.moveTo(p1.x, p1.y);
    line.lineTo(p2.x, p2.y);
    QPainterPathStroker stroker;
    stroker.setWidth(2.0 * radius);
    stroker.setCapStyle(Qt::RoundCap);

    QPainter *painter = static_cast<QPainter *>(context);
    painter->setPen(penOf(color));
    painter->setBrush(fillOf(color));
    const QPainterPath capsule = stroker.createStroke(line);
    painter->drawPath(capsule);
    if (isSensor(color))
        hatch(painter, capsule);
}

void drawSegment(b2Vec2 p1, b2Vec2 p2, b2HexColor color, void *context)
{
    QPainter *painter = static_cast<QPainter *>(context);
    painter->setPen(penOf(color));
    painter->drawLine(QPointF(p1.x, p1.y), QPointF(p2.x, p2.y));
}

void drawTransform(b2Transform transform, void *context)
{
    const float length = {{AXIS_LENGTH}};
    QPainter *painter = static_cast<QPainter *>(context);
    const b2Vec2 x = b2TransformPoint(transform, b2Vec2{ length, 0.0f });
    const b2Vec2 y = b2TransformPoint(transform, b2Vec2{ 0.0f, length });

    painter->setPen(penOf(b2HexColor(0x{{AXIS_X_COLOR}})));
    painter->drawLine(QPointF(transform.p.x, transform.p.y), QPointF(x.x, x.y));
    painter->setPen(penOf(b2HexColor(0x{{AXIS_Y_COLOR}})));
    painter->drawLine(QPointF(transform.p.x, transform.p.y), QPointF(y.x, y.y));
}

void drawPoint(b2Vec2 p, float size, b2HexColor color, void *context)
{
    QPainter *painter = static_cast<QPainter *>(context);
    const qreal radius = 0.5 * size / painter->transform().m11();  // size is in pixels
    painter->setPen(Qt::NoPen);
    painter->setBrush(colorOf(color));
    painter->drawEllipse(QPointF(p.x, p.y), radius, radius);
}

void drawString(b2Vec2, const char *, b2HexColor, void *)
{
}

// Box2D's own joint drawing is sized for a world measured in whole metres, so
// joints and axes are drawn here the way the editor draws them.

// A joint: a ring at each anchor, joined by a shaft.
void drawJoint(QPainter &painter, b2JointId joint)
{
    if (!b2Joint_IsValid(joint))
        return;
    const b2Vec2 a = b2Body_GetWorldPoint(b2Joint_GetBodyA(joint), b2Joint_GetLocalAnchorA(joint));
    const b2Vec2 b = b2Body_GetWorldPoint(b2Joint_GetBodyB(joint), b2Joint_GetLocalAnchorB(joint));
    const float ring = m({{JOINT_ANCHOR_RADIUS}});

    QPainterPath bone;
    bone.addEllipse(QPointF(a.x, a.y), ring, ring);
    const float length = b2Distance(a, b);
    if (length > m(1)) {
        const b2Vec2 across = b2MulSV(m(1.75f) / length, b2LeftPerp(b2Sub(b, a)));
        QPainterPath shaft;
        shaft.moveTo(a.x + across.x, a.y + across.y);
        shaft.lineTo(b.x + across.x, b.y + across.y);
        shaft.lineTo(b.x - across.x, b.y - across.y);
        shaft.lineTo(a.x - across.x, a.y - across.y);
        shaft.closeSubpath();
        bone = bone.united(shaft);
        QPainterPath ringB;
        ringB.addEllipse(QPointF(b.x, b.y), ring, ring);
        bone = bone.united(ringB);
    }

    QPen outline(QColor(64, 64, 64));
    outline.setWidthF(1.0);
    outline.setCosmetic(true);
    painter.setPen(outline);
    painter.setBrush(QColor({{JOINT_COLOR}}));
    painter.drawPath(bone);
}

// A body's axes, at the centre of its shapes. Box2D puts the centre of mass of
// a body with no mass -- a static one -- at its origin, so it is worked out
// from the shapes instead.
void drawAxes(QPainter &painter, b2BodyId body)
{
    if (!b2Body_IsValid(body))
        return;

    b2ShapeId shapes[64];
    const int count = b2Body_GetShapes(body, shapes, 64);
    float mass = 0.0f;
    b2Vec2 centre = b2Vec2_zero;
    for (int i = 0; i < count; ++i) {
        const b2MassData data = b2Shape_GetMassData(shapes[i]);
        centre = b2MulAdd(centre, data.mass, data.center);
        mass += data.mass;
    }

    b2Transform transform = b2Body_GetTransform(body);
    if (mass > 0.0f)
        transform.p = b2TransformPoint(transform, b2MulSV(1.0f / mass, centre));
    drawTransform(transform, &painter);
}

