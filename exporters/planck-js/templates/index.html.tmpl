<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{TITLE}}</title>
<style>
body { margin: 0; background: #2b2b2b; color: #e6e6e6; font: 13px system-ui, sans-serif; }
#controls { display: flex; gap: 6px; align-items: center; padding: 8px; }
canvas { display: block; margin: 0 8px 8px; border: 1px solid #555; }
</style>
</head>
<body>
{{CONTROLS}}
<canvas id="canvas" width="{{WIDTH}}" height="{{HEIGHT}}"></canvas>
{{LIBRARY}}
<script>
// {{TITLE}} -- generated by Physalis.
//
// A plain Planck.js program. createWorld() makes the world, its bodies,
// fixtures and joints; step() advances it and then does what the scene's rules
// say; draw() paints what the world holds.
//
// Planck works in metres. The scene was drawn at {{PIXELS_PER_METER}} units per
// metre, so a length below is written len(...) or m(x, y) in the units it was
// drawn in, and an angle is written rad(...) in degrees.

var pl = planck;

var PIXELS_PER_METER = {{PIXELS_PER_METER}};
function m(x, y) { return pl.Vec2(x / PIXELS_PER_METER, y / PIXELS_PER_METER); }
function len(length) { return length / PIXELS_PER_METER; }
function rad(degrees) { return degrees * Math.PI / 180; }

{{SETTINGS}}
var world;
{{IDS}}
{{STATE}}
function createWorld() {
    {{RESETS}}

    {{WORLD}}

    {{BODIES}}

    {{FIELD_BOUNDS}}

    {{JOINTS}}

    {{LISTENERS}}
}

function step(dt) {
    world.step(dt, 8, 3);
    {{STEP}}
}

{{HELPERS}}

// --- drawing ---------------------------------------------------------------

var canvas = document.getElementById("canvas");
var ctx = canvas.getContext("2d");
var debug = {{DEBUG_VIEW}};

// A sensor is drawn open and hatched, the way the editor draws it: an 8-pixel
// tile of lines in the style the settings chose, laid in screen pixels.
var SENSOR_FILLED = {{SENSOR_FILLED}};
var SENSOR_HATCH = (function () {
    var style = {{SENSOR_PATTERN}};  // Qt's brush style: 9 -, 10 |, 11 +, 12 /, 13 \, 14 x
    var tile = document.createElement("canvas");
    tile.width = tile.height = 8;
    var pen = tile.getContext("2d");
    pen.fillStyle = "{{SENSOR_COLOR}}";
    for (var i = 0; i < 8; ++i) {
        if (style === 9 || style === 11) pen.fillRect(i, 0, 1, 1);
        if (style === 10 || style === 11) pen.fillRect(0, i, 1, 1);
        if (style === 12 || style === 14) pen.fillRect(7 - i, i, 1, 1);
        if (style === 13 || style === 14) pen.fillRect(i, i, 1, 1);
    }
    return ctx.createPattern(tile, "repeat");
}());

// Box2D 2.4 collides a polygon as its outline grown by a thin skin, which makes
// shapes drawn edge to edge push each other apart. So every polygon above is
// built this far inside the outline drawn in the editor, and drawn grown back
// out by the same amount.
var POLYGON_INSET = len({{POLYGON_INSET}});

// A polygon's vertices, each edge moved out by `by`.
function grown(shape, by) {
    var vertices = shape.m_vertices, normals = shape.m_normals, count = shape.m_count;
    var out = [];
    for (var i = 0; i < count; ++i) {
        var n1 = normals[(i + count - 1) % count], n2 = normals[i];
        var k = by / Math.max(1 + n1.x * n2.x + n1.y * n2.y, 0.1);
        out.push(pl.Vec2(vertices[i].x + (n1.x + n2.x) * k, vertices[i].y + (n1.y + n2.y) * k));
    }
    return out;
}

function colourOf(body) {
    if (body.isDynamic()) return "{{COLOR_DYNAMIC}}";
    if (body.isKinematic()) return "{{COLOR_KINEMATIC}}";
    return "{{COLOR_STATIC}}";
}

function drawJoint(a, b) {
    var ring = {{JOINT_ANCHOR_RADIUS}} / PIXELS_PER_METER;
    var waist = 1.75 / PIXELS_PER_METER;
    ctx.fillStyle = "{{JOINT_COLOR}}";
    ctx.strokeStyle = "#404040";
    ctx.lineWidth = 1 / PIXELS_PER_METER;
    var length = pl.Vec2.distance(a, b);
    if (length > ring) {
        var along = pl.Vec2.mul(pl.Vec2.sub(b, a), 1 / length);
        var across = pl.Vec2(-along.y * waist, along.x * waist);
        ctx.beginPath();
        ctx.moveTo(a.x + across.x, a.y + across.y);
        ctx.lineTo(b.x + across.x, b.y + across.y);
        ctx.lineTo(b.x - across.x, b.y - across.y);
        ctx.lineTo(a.x - across.x, a.y - across.y);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
    }
    [a, b].forEach(function (at, index) {
        if (index === 1 && length <= 1 / PIXELS_PER_METER)
            return;
        ctx.beginPath();
        ctx.arc(at.x, at.y, ring, 0, 2 * Math.PI);
        ctx.fill();
        ctx.stroke();
    });
}

function axis(from, angle, colour) {
    var length = {{AXIS_LENGTH}} / PIXELS_PER_METER;
    ctx.strokeStyle = colour;
    ctx.lineWidth = {{AXIS_WIDTH}} / PIXELS_PER_METER;
    ctx.beginPath();
    ctx.moveTo(from.x, from.y);
    ctx.lineTo(from.x + Math.cos(angle) * length, from.y + Math.sin(angle) * length);
    ctx.stroke();
}

// Where a body's shapes are centred. Planck puts the centre of a body with no
// mass -- a static one -- at its origin, so it is worked out from the shapes.
function centreOf(body) {
    var total = 0, x = 0, y = 0;
    var data = { mass: 0, center: pl.Vec2(), I: 0 };
    for (var fixture = body.getFixtureList(); fixture; fixture = fixture.getNext()) {
        // By each fixture's own density, which also makes up for the area a
        // polygon lost to POLYGON_INSET -- so the axes sit where the mass is.
        fixture.getShape().computeMass(data, fixture.getDensity() || 1);
        total += data.mass;
        x += data.mass * data.center.x;
        y += data.mass * data.center.y;
    }
    return body.getWorldPoint(total > 0 ? pl.Vec2(x / total, y / total) : pl.Vec2());
}

function draw() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.fillStyle = "{{BACKGROUND}}";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Scene units to pixels one for one, with the scene's centre in the middle.
    ctx.translate(canvas.width / 2, canvas.height / 2);
    ctx.scale(PIXELS_PER_METER, PIXELS_PER_METER);
    ctx.lineWidth = 2 / PIXELS_PER_METER;

    for (var body = world.getBodyList(); body; body = body.getNext()) {
        var position = body.getPosition();
        ctx.save();
        ctx.translate(position.x, position.y);
        ctx.rotate(body.getAngle());
        ctx.strokeStyle = ctx.fillStyle = colourOf(body);

        for (var fixture = body.getFixtureList(); fixture; fixture = fixture.getNext()) {
            var shape = fixture.getShape();
            var solid = true;
            ctx.beginPath();
            if (shape.getType() === "circle") {
                var c = shape.getCenter();
                ctx.arc(c.x, c.y, shape.getRadius(), 0, 2 * Math.PI);
                ctx.moveTo(c.x, c.y);
                ctx.lineTo(c.x + shape.getRadius(), c.y);  // so you can see it turn
            } else if (shape.getType() === "edge") {
                ctx.moveTo(shape.m_vertex1.x, shape.m_vertex1.y);
                ctx.lineTo(shape.m_vertex2.x, shape.m_vertex2.y);
                solid = false;
            } else {
                var vertices = shape.getType() === "polygon" ? grown(shape, POLYGON_INSET)
                                                             : shape.m_vertices;
                var count = shape.getType() === "chain" ? shape.m_count : vertices.length;
                ctx.moveTo(vertices[0].x, vertices[0].y);
                for (var i = 1; i < count; ++i)
                    ctx.lineTo(vertices[i].x, vertices[i].y);
                solid = shape.getType() === "polygon" || shape.isLoop();
                if (solid)
                    ctx.closePath();
            }
            var sensor = fixture.isSensor();
            if (solid && (!sensor || SENSOR_FILLED)) {
                ctx.globalAlpha = {{FILL_ALPHA}};
                ctx.fill();
                ctx.globalAlpha = 1;
            }
            ctx.stroke();
            if (solid && sensor) {
                ctx.save();
                ctx.setTransform(1, 0, 0, 1, 0, 0);  // the path stays; the hatching is in pixels
                ctx.fillStyle = SENSOR_HATCH;
                ctx.fill();
                ctx.restore();
            }
        }
        ctx.restore();
    }

    if (!debug)
        return;

    // Joints as the editor draws them: a ring at each anchor, joined by a shaft.
    for (var joint = world.getJointList(); joint; joint = joint.getNext())
        drawJoint(joint.getAnchorA(), joint.getAnchorB());

    // Each body's axes, at the centre of its shapes.
    for (var each = world.getBodyList(); each; each = each.getNext()) {
        var centre = centreOf(each);
        axis(centre, each.getAngle(), "{{AXIS_X_COLOR}}");
        axis(centre, each.getAngle() + Math.PI / 2, "{{AXIS_Y_COLOR}}");
    }
    {{RAY_DRAWING}}
}

// --- running it ------------------------------------------------------------

var timer = null;

function run(on) {
    clearInterval(timer);
    timer = on ? setInterval(function () { step(1 / {{STEPS_PER_SECOND}}); draw(); },
                             1000 / {{STEPS_PER_SECOND}}) : null;
}

// Back to the beginning, and waiting to be started.
function reset() {
    run(false);
    createWorld();
    draw();
}

// Space runs and pauses, R goes back to the beginning, D shows joints.
document.addEventListener("keydown", function (event) {
    if (event.key === " ") { run(!timer); event.preventDefault(); }
    else if (event.key === "r" || event.key === "R") reset();
    else if (event.key === "d" || event.key === "D") { debug = !debug; draw(); }
});
{{CONTROL_WIRING}}
createWorld();
draw();
run(true);
</script>
</body>
</html>
