<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{TITLE}}</title>
<style>
body { margin: 0; background: {{BACKGROUND}}; color: #e6e6e6;
       font: 13px system-ui, sans-serif; overflow: hidden; }
#controls { display: flex; gap: 6px; align-items: center; padding: 8px; }
canvas { display: block; touch-action: none; cursor: grab; }
canvas.dragging { cursor: grabbing; }
</style>
</head>
<body>
{{CONTROLS}}
<canvas id="canvas" width="{{WIDTH}}" height="{{HEIGHT}}"></canvas>

//! Where the engine comes from is a converter setting. Built in, it is these
//! two: the wasm as base64 in a script the browser does not execute, and
//! box2d3wasm as a plain script rather than a module -- a module would be
//! fetched, and a fetch from a file URL is refused. Beside the page it is one
//! file holding both. From a CDN it is neither, and the boot at the end of the
//! page imports it instead.
{{WASM_SCRIPT}}
{{LIBRARY_SCRIPT}}

<script>
// {{TITLE}} -- generated by Physalis.
//
// createWorld() makes the world, its bodies, shapes and joints; step() advances
// it and then does what the scene's rules say; draw() paints what the world
// holds. Box2D works in metres and the scene was drawn at {{PIXELS_PER_METER}}
// units per metre, so a length is written len(...) or m(x, y) in the units it
// was drawn in, and an angle rad(...) in degrees.

var PIXELS_PER_METER = {{PIXELS_PER_METER}};
var b2 = null;   // the engine, once its wasm has been handed over

function m(x, y) { return new b2.b2Vec2(x / PIXELS_PER_METER, y / PIXELS_PER_METER); }
function vec(x, y) { return new b2.b2Vec2(x, y); }
function len(length) { return length / PIXELS_PER_METER; }
function rad(degrees) { return degrees * Math.PI / 180; }

// Box2D's scalar clamp, which the bindings do not carry: b2Clamp is the one
// for vectors and refuses a number.
function clampf(v, low, high) { return v < low ? low : (v > high ? high : v); }

// Two handles naming the same thing. Box2D's ids are values, not pointers, so
// they cannot be compared with ===.
function same(a, b) { return b2.B2_ID_EQUALS(a, b); }

// The bindings expose no constants, so an identity rotation is made rather than
// named.
function noTurn() { return b2.b2MakeRot(0); }

// A joint's frame on one body: where it holds, and which way it faces.
function frame(at, radians) {
    var t = new b2.b2Transform();
    t.p = at;
    t.q = b2.b2MakeRot(radians);
    return t;
}

var world = null;
{{IDS}}
{{RANDOM}}
{{STATE}}

// Every body and shape as it was built, so drawing needs no introspection:
// Box2D 3 keeps no list of the bodies in a world, and what the editor drew is
// known here anyway.
var drawn = [];

function createWorld() {
    drawn = [];
    {{RESETS}}

    {{WORLD}}

    {{BODIES}}

    {{FIELD_BOUNDS}}

    {{JOINTS}}

    {{SHOOTABLE}}
}

function step(dt) {
    b2.b2World_Step(world, dt, {{SUB_STEPS}});
    {{STEP}}
}

{{HELPERS}}

// --- drawing ---------------------------------------------------------------

var canvas = document.getElementById("canvas");
var ctx = canvas.getContext("2d");
var debug = {{DEBUG_VIEW}};

// A sensor is drawn open and hatched, the way the editor draws it: an 8-pixel
// tile of lines in the style the settings chose, laid in screen pixels.
var SENSOR_FILLED = {{SENSOR_FILLED}};
var SENSOR_HATCH = (function () {
    var style = {{SENSOR_PATTERN}};  // Qt brush style: 9 dash, 10 pipe, 11 plus, 12 up, 13 down, 14 cross
    var tile = document.createElement("canvas");
    tile.width = tile.height = 8;
    var pen = tile.getContext("2d");
    pen.fillStyle = "{{SENSOR_COLOR}}";
    for (var i = 0; i < 8; ++i) {
        if (style === 9 || style === 11) pen.fillRect(i, 0, 1, 1);
        if (style === 10 || style === 11) pen.fillRect(0, i, 1, 1);
        if (style === 12 || style === 14) pen.fillRect(7 - i, i, 1, 1);
        if (style === 13 || style === 14) pen.fillRect(i, i, 1, 1);
    }
    return ctx.createPattern(tile, "repeat");
}());

// The editor's own colours, which it keeps as bare hex.
function colourOf(type) {
    if (type === "dynamic") return "#{{COLOR_DYNAMIC}}";
    if (type === "kinematic") return "#{{COLOR_KINEMATIC}}";
    return "#{{COLOR_STATIC}}";
}

// A joint the way the editor draws it: a ring at each anchor, joined by a
// waisted shaft. The anchors are the origins of the joint's two frames.
function drawJoint(joint) {
    if (!b2.b2Joint_IsValid(joint))
        return;
    var a = b2.b2Body_GetWorldPoint(b2.b2Joint_GetBodyA(joint),
                                    b2.b2Joint_GetLocalFrameA(joint).p);
    var b = b2.b2Body_GetWorldPoint(b2.b2Joint_GetBodyB(joint),
                                    b2.b2Joint_GetLocalFrameB(joint).p);
    var ax = a.x * PIXELS_PER_METER, ay = a.y * PIXELS_PER_METER;
    var bx = b.x * PIXELS_PER_METER, by = b.y * PIXELS_PER_METER;
    var ring = {{JOINT_ANCHOR_RADIUS}};

    ctx.fillStyle = "{{JOINT_COLOR}}";
    ctx.strokeStyle = "#404040";
    ctx.lineWidth = 1 / camera.scale;

    var span = Math.sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
    if (span > 1) {
        var waist = 1.75 / span;
        var px = -(by - ay) * waist, py = (bx - ax) * waist;
        ctx.beginPath();
        ctx.moveTo(ax + px, ay + py);
        ctx.lineTo(bx + px, by + py);
        ctx.lineTo(bx - px, by - py);
        ctx.lineTo(ax - px, ay - py);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
    }
    var ends = span > 1 ? [[ax, ay], [bx, by]] : [[ax, ay]];
    for (var e = 0; e < ends.length; ++e) {
        ctx.beginPath();
        ctx.arc(ends[e][0], ends[e][1], ring, 0, 2 * Math.PI);
        ctx.fill();
        ctx.stroke();
    }
}

// A body's heading, drawn where its shapes balance rather than at its origin --
// which is the point worth showing, and what a dynamic body turns about. The
// centre came from the editor and is body-local: asking the solver instead put
// every static body's axes on its origin, since a static body has no mass.
function drawAxes(body) {
    if (!b2.b2Body_IsValid(body.id))
        return;
    var at = b2.b2Body_GetPosition(body.id);
    var turn = b2.b2Rot_GetAngle(b2.b2Body_GetRotation(body.id));
    var cs = Math.cos(turn), sn = Math.sin(turn);
    var x = at.x * PIXELS_PER_METER + body.centre[0] * cs - body.centre[1] * sn;
    var y = at.y * PIXELS_PER_METER + body.centre[0] * sn + body.centre[1] * cs;
    var reach = {{AXIS_LENGTH}} * PIXELS_PER_METER;
    var pairs = [[turn, "{{AXIS_X_COLOR}}"], [turn + Math.PI / 2, "{{AXIS_Y_COLOR}}"]];
    ctx.lineWidth = 1.5 / camera.scale;
    for (var i = 0; i < pairs.length; ++i) {
        ctx.strokeStyle = "#" + pairs[i][1];
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + Math.cos(pairs[i][0]) * reach, y + Math.sin(pairs[i][0]) * reach);
        ctx.stroke();
    }
}

{{DRAW_RAY}}
{{LOG}}
{{SLINGSHOT}}

// Scene units to pixels one for one, with the field's centre in the middle --
// and whatever the viewer has panned and zoomed to on top of that.
var camera = { x: 0, y: 0, scale: 1 };

function applyView() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.translate(canvas.width / 2, canvas.height / 2);
    ctx.scale(camera.scale, camera.scale);
    ctx.translate(camera.x - {{VIEW_CENTER_X}}, camera.y - {{VIEW_CENTER_Y}});
}

function draw() {
    applyView();
    ctx.lineWidth = 2 / camera.scale;

    for (var i = 0; i < drawn.length; ++i) {
        var body = drawn[i];
        if (!b2.b2Body_IsValid(body.id))
            continue;
        var at = b2.b2Body_GetPosition(body.id);
        var turn = b2.b2Rot_GetAngle(b2.b2Body_GetRotation(body.id));
        ctx.save();
        ctx.translate(at.x * PIXELS_PER_METER, at.y * PIXELS_PER_METER);
        ctx.rotate(turn);
        ctx.strokeStyle = ctx.fillStyle = colourOf(body.type);
        for (var k = 0; k < body.parts.length; ++k) {
            drawPart(body.parts[k]);
            if (body.shootable)
                markShootable(body.parts[k]);
        }
        ctx.restore();
    }

    {{DEBUG_DRAWING}}
    {{DRAW_SHOT}}
    {{DRAW_LOG}}
}

// A body that can be flung wears a second, dotted outline just inside its own --
// on a table of balls, that is how the cue ball is told apart. Two screen pixels
// inside the border whatever the zoom, done by shrinking the shape about its
// middle: exact for circles and boxes, close enough for anything else. An
// outline encloses nothing, so it gets none.
function markShootable(part) {
    if (part.kind === "segments")
        return;
    var inset = (2 / 2 + 2 + 0.75) / camera.scale;
    ctx.save();
    ctx.setLineDash([1 / camera.scale, 3 / camera.scale]);
    ctx.lineWidth = 1.5 / camera.scale;
    ctx.beginPath();
    if (part.kind === "circle") {
        if (part.radius <= inset) { ctx.restore(); return; }
        ctx.arc(part.x, part.y, part.radius - inset, 0, 2 * Math.PI);
    } else {
        var pts = part.points, lowX = pts[0][0], lowY = pts[0][1], highX = lowX, highY = lowY;
        for (var b = 1; b < pts.length; ++b) {
            lowX = Math.min(lowX, pts[b][0]); highX = Math.max(highX, pts[b][0]);
            lowY = Math.min(lowY, pts[b][1]); highY = Math.max(highY, pts[b][1]);
        }
        var wide = highX - lowX, tall = highY - lowY;
        if (wide <= 2 * inset || tall <= 2 * inset) { ctx.restore(); return; }
        var midX = (lowX + highX) / 2, midY = (lowY + highY) / 2;
        var sx = (wide - 2 * inset) / wide, sy = (tall - 2 * inset) / tall;
        for (var q = 0; q < pts.length; ++q) {
            var x = midX + (pts[q][0] - midX) * sx, y = midY + (pts[q][1] - midY) * sy;
            if (q === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.closePath();
    }
    ctx.stroke();
    ctx.restore();
}

// One shape of a body, in that body's own frame and in scene units: exactly what
// the editor drew, rather than what the solver made of it.
function drawPart(part) {
    ctx.beginPath();
    if (part.kind === "circle") {
        ctx.arc(part.x, part.y, part.radius, 0, 2 * Math.PI);
        ctx.moveTo(part.x, part.y);
        ctx.lineTo(part.x + part.radius, part.y);   // so you can see it turn
    } else if (part.kind === "segments") {
        for (var i = 0; i + 1 < part.points.length; ++i) {
            ctx.moveTo(part.points[i][0], part.points[i][1]);
            ctx.lineTo(part.points[i + 1][0], part.points[i + 1][1]);
        }
        ctx.stroke();
        return;   // an outline has no inside to fill
    } else if (part.radius > 0) {
        // Rounded corners, drawn from the midpoint of each edge so arcTo always
        // has an edge behind it. At half the shorter side this is a capsule,
        // which is what the editor drew and what Box2D collides with.
        var round = part.points, n = round.length;
        var mid = function (a, b) {
            return [(round[a][0] + round[b][0]) / 2, (round[a][1] + round[b][1]) / 2];
        };
        var from = mid(n - 1, 0);
        ctx.moveTo(from[0], from[1]);
        for (var v = 0; v < n; ++v) {
            var to = mid(v, (v + 1) % n);
            ctx.arcTo(round[v][0], round[v][1], to[0], to[1], part.radius);
        }
        ctx.closePath();
    } else {
        var points = part.points;
        ctx.moveTo(points[0][0], points[0][1]);
        for (var p = 1; p < points.length; ++p)
            ctx.lineTo(points[p][0], points[p][1]);
        ctx.closePath();
    }

    if (!part.sensor || SENSOR_FILLED) {
        ctx.globalAlpha = {{FILL_ALPHA}} / 255;
        ctx.fill();
        ctx.globalAlpha = 1;
    }
    ctx.stroke();
    if (part.sensor) {
        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);   // the path stays; the hatching is in pixels
        ctx.fillStyle = SENSOR_HATCH;
        ctx.fill();
        ctx.restore();
    }
}

// --- running it ------------------------------------------------------------

var timer = null;

// A rule asking for the run to stop or to hold cannot do it where it fires --
// that is inside the step, with the solver on the stack -- so it leaves the
// request here and the tick carries it out once the step is over. 1 stops, 2
// holds, the way the editor's own controller remembers it.
// A rule asking for the run to stop or to hold cannot do it where it fires --
// that is inside the step, with the solver on the stack -- so it leaves the
// request here and the tick carries it out once the step is over. 1 stops, 2
// holds, the way the editor's own controller remembers it.
var pendingRun = 0;

function tick() {
    step(1 / {{STEPS_PER_SECOND}});
    draw();
    var asked = pendingRun;
    pendingRun = 0;
    if (asked === 1)
        reset();
    else if (asked === 2)
        run(false);
}

function run(on) {
    clearInterval(timer);
    pendingRun = 0;
    timer = on ? setInterval(tick, 1000 / {{STEPS_PER_SECOND}}) : null;
}

// Back to the beginning, and waiting to be started.
function reset() {
    run(false);
    if (world && b2.b2World_IsValid(world))
        b2.b2DestroyWorld(world);
    createWorld();
    draw();
}

// Space runs and pauses, R goes back to the beginning, D shows the helpers.
document.addEventListener("keydown", function (event) {
    {{SHOT_CANCEL}}
    if (event.key === " ") { run(!timer); event.preventDefault(); }
    else if (event.key === "r" || event.key === "R") reset();
    else if (event.key === "d" || event.key === "D") { debug = !debug; draw(); }
});

// Drag to move the view, wheel to zoom about the pointer, the way the editor's
// own canvas works.
(function () {
    var held = false, fromX = 0, fromY = 0;
    canvas.addEventListener("pointerdown", function (e) {
        {{SHOT_DOWN}}
        held = true; fromX = e.clientX; fromY = e.clientY;
        canvas.classList.add("dragging");
        canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener("pointerup", function (e) {
        {{SHOT_UP}}
        held = false; canvas.classList.remove("dragging");
        canvas.releasePointerCapture(e.pointerId);
    });
    canvas.addEventListener("pointermove", function (e) {
        {{SHOT_MOVE}}
        if (!held) return;
        camera.x += (e.clientX - fromX) / camera.scale;
        camera.y += (e.clientY - fromY) / camera.scale;
        fromX = e.clientX; fromY = e.clientY;
        if (!timer) draw();
    });
    canvas.addEventListener("wheel", function (e) {
        e.preventDefault();
        var box = canvas.getBoundingClientRect();
        // The point under the pointer stays under it, which is what makes
        // zooming feel like moving a lens rather than jumping.
        var px = e.clientX - box.left - canvas.width / 2;
        var py = e.clientY - box.top - canvas.height / 2;
        var was = camera.scale;
        var factor = Math.pow(1.0015, -e.deltaY);
        camera.scale = Math.min(Math.max(was * factor, 0.05), 40);
        camera.x += px / camera.scale - px / was;
        camera.y += py / camera.scale - py / was;
        if (!timer) draw();
    }, { passive: false });

    // The canvas fills the window under the controls, so the view is not stuck
    // at the field's size.
    function fit() {
        var top = document.getElementById("controls");
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight - (top ? top.offsetHeight : 0);
        if (world) draw();
    }
    window.addEventListener("resize", fit);
    fit();
}());

// Everything is ready; the engine is the last thing to arrive.
function begin(engine) {
    b2 = engine;
    createWorld();
    draw();
    {{CONTROL_WIRING}}
    run(true);
}
{{BOOT}}
</script>
{{BOOT_MODULE}}
</body>
</html>
